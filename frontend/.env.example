# Public URL of the backend API (no trailing slash). Include https:// (required for
# correct absolute URLs; host-only values used to resolve under the Vercel origin).
# Leave empty for local development — Vite proxies /api to http://localhost:3001.
#
# Vercel production example:
# VITE_API_BASE_URL=https://tu-servicio.up.railway.app

# VITE_API_BASE_URL=
