PORT=3001
NODE_ENV=development

# ── Google Ad Manager Integration ──────────────────────────────────────────────
# Set to true to use the real GAM API instead of mock data
USE_REAL_GAM_API=false

# Your Ad Manager network code (found in GAM UI → Admin → Network settings)
GAM_NETWORK_CODE=

# Service account credentials — choose ONE of the two options:

# Option A: path to the downloaded service account JSON key file
GAM_KEY_FILE=./credentials/gam-service-account.json

# Option B: full JSON content as a single-line string (useful for CI/cloud envs)
# GAM_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
