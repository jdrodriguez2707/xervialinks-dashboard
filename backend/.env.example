PORT=3001
NODE_ENV=development

# ── Auth ────────────────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens — change this to a long random string in production
JWT_SECRET=change-this-secret-in-production
# Secret for encrypting the admin-visible worker password field
PASSWORD_VIEW_SECRET=change-this-password-view-secret

# Default admin credentials seeded on first run
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ── Google Ad Manager Integration ──────────────────────────────────────────────
# Set to true to use the real GAM API instead of mock data
USE_REAL_GAM_API=false

# Your Ad Manager network code (found in GAM UI → Admin → Network settings)
GAM_NETWORK_CODE=

# Service account credentials — choose ONE of the two options:

# Option A: path to the downloaded service account JSON key file
GAM_KEY_FILE=./credentials/gam-service-account.json

# Option B: full JSON content as a single-line string (useful for CI/cloud envs)
# GAM_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── Report Sync Tuning ──────────────────────────────────────────────────────────
# Batch interval in milliseconds (default: 3 hours)
REPORTS_BATCH_INTERVAL_MS=10800000

# Backfill interval in milliseconds (default: 24 hours)
REPORTS_BACKFILL_INTERVAL_MS=86400000

# Rolling window for regular sync (days, default: 30)
REPORTS_BATCH_WINDOW_DAYS=30

# Historical backfill window (days, default: ~12 months)
REPORTS_BACKFILL_WINDOW_DAYS=370
