PORT=3001
NODE_ENV=development

# ── Production / deploy (Railway, etc.) ─────────────────────────────────────────
# Comma-separated browser origins allowed to call the API (e.g. https://tu-app.vercel.app)
# Required in production; empty in development = permissive CORS for local Vite.
CORS_ORIGIN=

# SQLite path: relative to process.cwd() or absolute. On Railway use a volume, e.g. /data/app.db
# DATABASE_PATH=/data/app.db

# Secret for POST /api/internal/sync-reports (header X-Cron-Secret). Leave empty to hide the endpoint.
# CRON_SECRET=

# Set to false to disable in-process sync timers (use Railway Cron + internal endpoint instead).
# ENABLE_SYNC_SCHEDULER=true

# Set to true to skip the one-off sync on server boot (optional with external cron only).
# SKIP_STARTUP_SYNC=false

# ── Auth ────────────────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens — change this to a long random string in production
JWT_SECRET=change-this-secret-in-production
# Secret for encrypting the admin-visible worker password field
PASSWORD_VIEW_SECRET=change-this-password-view-secret

# Default admin credentials seeded on first run
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ── Google Ad Manager Integration ──────────────────────────────────────────────
# Set to true to use the real GAM API instead of mock data
USE_REAL_GAM_API=false

# Your Ad Manager network code (found in GAM UI → Admin → Network settings)
GAM_NETWORK_CODE=

# Optional display label for the default network row seeded on first DB migration
# GAM_NETWORK_DISPLAY_NAME=Mi red principal

# Service account credentials — choose ONE of the two options:

# Option A: path to the downloaded service account JSON key file
GAM_KEY_FILE=./credentials/gam-service-account.json

# Option B: full JSON content as a single-line string (useful for CI/cloud envs)
# Generate locally: cd backend && jq -c . credentials/gam-service-account.json
# GAM_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── Report Sync Tuning ──────────────────────────────────────────────────────────
# Batch interval in milliseconds (default: 3 hours)
REPORTS_BATCH_INTERVAL_MS=10800000

# Backfill interval in milliseconds (default: 24 hours)
REPORTS_BACKFILL_INTERVAL_MS=86400000

# Rolling window for regular sync (days, default: 30)
REPORTS_BATCH_WINDOW_DAYS=30

# Historical backfill window (days, default: 120 ~4 months). Increase e.g. 370 for ~12 months if GAM accepts it.
REPORTS_BACKFILL_WINDOW_DAYS=120

# Default IANA timezone when the client does not send X-Client-Timezone
# DEFAULT_REPORT_TIMEZONE=America/Bogota
